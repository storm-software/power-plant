{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "outDir": "./out-tsc",
    "rootDir": "."
  },
  "references": [
    {
      "path": "../../base/schema/tsconfig.lib.json"
    },
    {
      "path": "../../schemas/dtcg-schema/tsconfig.lib.json"
    },
    {
      "path": "../../base/core/tsconfig.lib.json"
    }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts",
    "powerlines.config.ts",
    "powerlines.d.ts",
    "package.json"
  ],
  "exclude": ["vitest.config.ts", "test/**/*.ts"]
}
